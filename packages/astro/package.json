{
  "name": "lucide-extended-astro",
  "version": "0.8.0",
  "description": "Filled and duotone Astro icons using Lucide's icon names, designed to sit alongside @lucide/astro. Not affiliated with or endorsed by Lucide.",
  "keywords": [
    "icons",
    "astro",
    "astro-component",
    "svg",
    "filled",
    "duotone",
    "lucide"
  ],
  "homepage": "https://github.com/applifted/lucide-extended/tree/main/packages/astro#readme",
  "bugs": {
    "url": "https://github.com/applifted/lucide-extended/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/applifted/lucide-extended.git",
    "directory": "packages/astro"
  },
  "license": "ISC",
  "author": "Applifted",
  "funding": "https://buymeacoffee.com/applifted",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "icons.json",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/icons/*.ts",
      "import": "./src/icons/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "astro check",
    "test": "vitest run",
    "check:package": "publint",
    "prepublishOnly": "npm --prefix ../.. run build && npm test && npm run check:package"
  },
  "peerDependencies": {
    "astro": ">=4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "astro": "^7.4.4",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

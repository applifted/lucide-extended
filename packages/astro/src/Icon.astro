---
import { DEFAULT_SECONDARY_OPACITY } from './constants'
import type { DuotoneIconProps, IconNode, IconNodeKind } from './types'

interface Props extends DuotoneIconProps {
  slug: string
  nodes: IconNode[]
}

// Every icon renders this component, passing its slug and nodes.
const {
  slug,
  nodes,
  size = 24,
  color = 'currentColor',
  secondaryColor,
  secondaryOpacity = DEFAULT_SECONDARY_OPACITY,
  strokeWidth: _strokeWidth,
  absoluteStrokeWidth: _absoluteStrokeWidth,
  class: className,
  ...rest
} = Astro.props

const labelled = rest['aria-label'] != null || rest['aria-labelledby'] != null

const paint = (kind: IconNodeKind) => {
  if (kind === 'stroke') {
    return { fill: 'none', stroke: color, 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const
  }
  if (kind === 'tint') return { fill: secondaryColor ?? color, opacity: secondaryOpacity }
  return { fill: color }
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  class={['applifted-icon', `applifted-icon-${slug}`, className].filter(Boolean).join(' ')}
  aria-hidden={labelled ? undefined : 'true'}
  {...rest}
>
  {nodes.map(([, attrs, kind]) => <path {...attrs} {...paint(kind)} />)}
  <slot />
</svg>

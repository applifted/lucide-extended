{
  "name": "lucide-extended-svelte",
  "version": "0.9.0",
  "description": "Filled and duotone Svelte icons using Lucide's icon names, designed to sit alongside @lucide/svelte. Not affiliated with or endorsed by Lucide.",
  "keywords": [
    "icons",
    "svelte",
    "svg",
    "filled",
    "duotone",
    "lucide"
  ],
  "homepage": "https://github.com/applifted/lucide-extended/tree/main/packages/svelte#readme",
  "bugs": {
    "url": "https://github.com/applifted/lucide-extended/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/applifted/lucide-extended.git",
    "directory": "packages/svelte"
  },
  "license": "ISC",
  "author": "Applifted",
  "funding": "https://buymeacoffee.com/applifted",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "icons.json",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "svelte": "./dist/icons/*.js",
      "default": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "test": "vitest run && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:package": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "npm --prefix ../.. run build && npm test && npm run check:package"
  },
  "peerDependencies": {
    "svelte": ">=5.16"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

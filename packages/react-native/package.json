{
  "name": "lucide-extended-react-native",
  "version": "0.8.0",
  "description": "Filled and duotone React Native icons using Lucide's icon names, designed to sit alongside lucide-react-native. Not affiliated with or endorsed by Lucide.",
  "keywords": [
    "icons",
    "react-native",
    "react-native-svg",
    "svg",
    "filled",
    "duotone",
    "lucide"
  ],
  "homepage": "https://github.com/applifted/lucide-extended/tree/main/packages/react-native#readme",
  "bugs": {
    "url": "https://github.com/applifted/lucide-extended/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/applifted/lucide-extended.git",
    "directory": "packages/react-native"
  },
  "license": "ISC",
  "author": "Applifted",
  "funding": "https://buymeacoffee.com/applifted",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/*": [
        "./dist/*"
      ],
      "*": [
        "./dist/icons/*.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "icons.json",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "npm --prefix ../.. run build && npm test && npm run check:package"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native-svg": ">=13"
  },
  "devDependencies": {
    "react-native": "^0.88.1",
    "react-native-svg": "^15.16.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

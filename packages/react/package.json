{
  "name": "lucide-extended-react",
  "version": "0.4.0",
  "description": "Filled and duotone React icons using Lucide's icon names, designed to sit alongside lucide-react. Not affiliated with or endorsed by Lucide.",
  "keywords": [
    "icons",
    "react",
    "svg",
    "filled",
    "duotone",
    "lucide"
  ],
  "homepage": "https://github.com/applifted/lucide-extended#readme",
  "bugs": {
    "url": "https://github.com/applifted/lucide-extended/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/applifted/lucide-extended.git",
    "directory": "packages/react"
  },
  "license": "ISC",
  "author": "Applifted",
  "funding": "https://buymeacoffee.com/applifted",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "icons.json",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "npm --prefix ../.. run build && npm test && npm run check:package"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

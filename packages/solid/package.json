{
  "name": "lucide-extended-solid",
  "version": "0.8.0",
  "description": "Filled and duotone Solid icons using Lucide's icon names, designed to sit alongside lucide-solid. Not affiliated with or endorsed by Lucide.",
  "keywords": [
    "icons",
    "solid",
    "solidjs",
    "svg",
    "filled",
    "duotone",
    "lucide"
  ],
  "homepage": "https://github.com/applifted/lucide-extended/tree/main/packages/solid#readme",
  "bugs": {
    "url": "https://github.com/applifted/lucide-extended/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/applifted/lucide-extended.git",
    "directory": "packages/solid"
  },
  "license": "ISC",
  "author": "Applifted",
  "funding": "https://buymeacoffee.com/applifted",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "icons.json",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "npm --prefix ../.. run build && npm test && npm run check:package"
  },
  "peerDependencies": {
    "solid-js": ">=1.8"
  },
  "devDependencies": {
    "solid-js": "^1.9.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

{
  "name": "@applifted/icons-react",
  "version": "0.1.0",
  "description": "Filled and duotone React icons using Lucide's icon names, designed to sit alongside lucide-react.",
  "keywords": [
    "icons",
    "react",
    "svg",
    "filled",
    "duotone",
    "lucide"
  ],
  "homepage": "https://github.com/applifted/icons#readme",
  "bugs": {
    "url": "https://github.com/applifted/icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/applifted/icons.git"
  },
  "license": "ISC",
  "author": "Applifted",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/icons/*.d.ts",
      "import": "./dist/icons/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "generate": "tsx scripts/generate.ts",
    "qa": "npm run generate && tsx scripts/qa.ts",
    "build": "npm run validate && npm run generate && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile esm-only",
    "prepublishOnly": "npm run build && npm test && npm run check:package"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "fast-glob": "^3.3.3",
    "jsdom": "^30.1.1",
    "lucide-react": "1.45.0",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svgo": "^4.1.0",
    "svgson": "^5.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

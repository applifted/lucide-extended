{
  "name": "lucide-extended",
  "private": true,
  "description": "Monorepo for the lucide-extended-<framework> icon packages. Not affiliated with or endorsed by Lucide.",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "validate": "tsx scripts/validate.ts",
    "generate": "tsx scripts/generate.ts",
    "catalogue": "tsx scripts/catalogue.ts",
    "qa": "npm run generate && tsx scripts/qa.ts",
    "build": "npm run validate && npm run generate && npm run build --workspaces",
    "test": "vitest run && npm test --workspaces",
    "check:package": "npm run check:package --workspaces",
    "verify": "tsx scripts/verify.ts",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "fast-glob": "^3.3.3",
    "jsdom": "^30.1.1",
    "lucide-react": "1.66.0",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svgo": "^4.1.0",
    "svgson": "^5.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
